{
  "task": "D-01",
  "entity_type": "SECRET",
  "synthetic": true,
  "rules": "政策前缀(sk-/ak-)+纯字母数字主体(≥16位,参数化),两侧字母数字边界;PEM私钥块整块(首尾算法名一致,块体非空且只含base64字符集与空白);语境词(password/密码/口令)+分隔符(:：=,允许空白与成对引号)后的非空值;公开占位标记(example/xxxx/your/等,参数化)不命中;未定义语境不命中。全部命中输出 priority=0。",
  "cases": [
    {
      "id": "d01-api-key-sk-prefix",
      "text": "在配置中写入 sk-AbCdEfG0123456789xyz 后保存",
      "expect": "hit",
      "spans": [
        {
          "start": 7,
          "end": 30,
          "entity_type": "SECRET",
          "priority": 0
        }
      ]
    },
    {
      "id": "d01-api-key-ak-prefix",
      "text": "使用 ak-9f8e7d6c5b4a3210ZxQw 调用接口",
      "expect": "hit",
      "spans": [
        {
          "start": 3,
          "end": 26,
          "entity_type": "SECRET",
          "priority": 0
        }
      ]
    },
    {
      "id": "d01-pem-rsa-block",
      "text": "服务器密钥如下\n-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA7syntheticFixtureKeyBodyLineNumberOne12345\na1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9T0u1V2w3X4y5Z6\n-----END RSA PRIVATE KEY-----\n请妥善保管",
      "expect": "hit",
      "spans": [
        {
          "start": 8,
          "end": 181,
          "entity_type": "SECRET",
          "priority": 0
        }
      ]
    },
    {
      "id": "d01-pem-pkcs8-block",
      "text": "私钥备份\n-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC7a1B2c3D4e5F6g\n-----END PRIVATE KEY-----\n完",
      "expect": "hit",
      "spans": [
        {
          "start": 5,
          "end": 124,
          "entity_type": "SECRET",
          "priority": 0
        }
      ]
    },
    {
      "id": "d01-password-zh",
      "text": "数据库密码：P@ssw0rd!2024",
      "expect": "hit",
      "spans": [
        {
          "start": 6,
          "end": 19,
          "entity_type": "SECRET",
          "priority": 0
        }
      ]
    },
    {
      "id": "d01-password-json",
      "text": "{\"password\":\"kJ9#mQ2vL8p\"}",
      "expect": "hit",
      "spans": [
        {
          "start": 13,
          "end": 24,
          "entity_type": "SECRET",
          "priority": 0
        }
      ]
    },
    {
      "id": "d01-password-kouling",
      "text": "系统口令=z9X8c7v6B5nMq",
      "expect": "hit",
      "spans": [
        {
          "start": 5,
          "end": 18,
          "entity_type": "SECRET",
          "priority": 0
        }
      ]
    },
    {
      "id": "d01-api-key-short-body",
      "text": "临时密钥 sk-AbC123 不可用",
      "expect": "miss",
      "spans": []
