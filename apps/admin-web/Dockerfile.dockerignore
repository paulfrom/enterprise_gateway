# Default deny; re-deny children after allowing traversal directories.
**
!package.json
!package-lock.json
!.node-version
!contracts/
contracts/**
!contracts/admin.openapi.json
!deploy/
deploy/**
!deploy/nginx/
deploy/nginx/**
!deploy/nginx/admin.conf
!apps/
apps/**
!apps/admin-web/
apps/admin-web/**
!apps/admin-web/package.json
!apps/admin-web/index.html
!apps/admin-web/tsconfig.json
!apps/admin-web/tsconfig.app.json
!apps/admin-web/tsconfig.node.json
!apps/admin-web/vite.config.ts
!apps/admin-web/src/
apps/admin-web/src/**
!apps/admin-web/src/**/*.ts
!apps/admin-web/src/**/*.tsx
!apps/admin-web/src/**/*.css
!apps/admin-web/public/
apps/admin-web/public/**
!apps/admin-web/public/**/*.svg
!apps/admin-web/public/**/*.png
!apps/admin-web/public/**/*.ico
# Never accept secrets or generated content, including inside allowed trees.
**/.env*
**/*.key
**/*.pem
**/secrets/**
**/models/**
**/.runtime_state/**
**/node_modules/**
**/dist/**
**/*.log
